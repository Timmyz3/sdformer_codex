  "findings": [
    {
      "id": "M112-H-P1-01-FOUNDRY-1R1W-MACRO-UNPROVEN",
      "severity": "P1",
      "finding": "The 96 memories are behavioral one-cycle synchronous 3072x24 1R1W arrays. No compiler instance, DB/lib, PVT corner, depth/width rounding, port mode, RDW behavior, ECC or redundancy is frozen.",
      "impact": "Narrower words are directionally plausible, but macro feasibility, density, frequency and energy remain unknown."
    },
    {
      "id": "M112-H-P1-02-AGGREGATE-WIRING-AND-FANOUT-UNCHANGED",
      "severity": "P1",
      "finding": "Every vector update simultaneously activates all 96 macros and still moves 2304 read plus 2304 write bits, while address/enables fan out to 96 instances and commit/delta remain 2304-bit paths.",
      "impact": "Lane slicing removes a monolithic wide word but does not remove aggregate wiring, switching or congestion."
    },
    {
      "id": "M112-H-P1-03-SRAM-ADDER-SRAM-TIMING-UNPROVEN",
      "severity": "P1",
      "finding": "II=1 assumes a one-cycle synchronous read followed by 96 signed25 additions, overflow reduction and a next-edge write across the physical macro/floorplan.",
      "impact": "A registered-output or slower compiler macro would change pipeline latency and invalidate the current cycle protocol."
    },
    {
      "id": "M112-H-P1-04-INTEGRATED-ACTUAL-REPLAY-ABSENT",
      "severity": "P1",
      "finding": "M110 and M112 are separately directed, but there is no actual heldout M110-to-M112/PWP/shared-weight/flush/commit commercial cycle miter.",
      "impact": "M109-r2 2.535462x remains a software schedule projection."
    },
    {
      "id": "M112-H-P1-05-SAME-ADDRESS-LIVENESS-EXTERNAL",
      "severity": "P1",
      "finding": "Consecutive same-address updates intentionally cause reset-only quarantine. Safety is correct, but workload liveness depends on an external spacing promise that has not been replayed on actual heldout traffic through the integrated chain."
    },
    {
      "id": "M112-H-P1-06-MATCHED-PHYSICAL-BASELINE-ABSENT",
      "severity": "P1",
      "finding": "There is no same-library, same-frequency, equal-area baseline including compiled macros, transpose, precompaction delivery, shared SRAM and commit traffic.",
      "impact": "No physical speedup, energy efficiency or DATE headline comparison is admitted."
    },
    {
      "id": "M112-H-P2-01-PRODUCTION-MAPPING-MONITOR-INCOMPLETE",
      "severity": "P2",
      "finding": "Production SVA checks only flattened address range, not exact block*384+row mapping, onehot source selection or every lane-to-vector write slice. The independent directed miter checks these explicitly."
    },
    {
      "id": "M112-H-P2-02-NEGATIVE-OVERFLOW-AND-RANGE-NOT-PRODUCTION",
      "severity": "P2",
      "finding": "Production attacks positive overflow and same-address RDW, but not negative overflow, row384 or start/update collision. Independent VCS closes the directed cases."
    },
    {
      "id": "M112-H-P2-03-VALID-BITS-OMITTED-FROM-LINKED-STORAGE",
      "severity": "P2",
      "finding": "M109's 909352-byte lower bound excludes the implemented 3072 lazy-valid bits. The minimum logical subtotal is 909736 bytes before controller, macro rounding and ECC."
    },
    {
      "id": "M112-H-P2-04-DIRECTED-NOT-FORMAL-EQUIVALENCE",
      "severity": "P2",
      "finding": "The independent wrapper-versus-M111 cycle miter covers reverse/permuted vectors, endpoints, stalls and faults but is not exhaustive formal equivalence over all histories and reset placements."
    },
    {
      "id": "M112-H-P2-05-COMMIT-SPARSE-ENERGY-UNMODELED",
      "severity": "P2",
      "finding": "Invalid rows avoid macro reads and commit zero correctly, but all 3072 commit vectors are still emitted per window; zero-vector bus/consumer energy and sparse commit alternatives are not evaluated."
