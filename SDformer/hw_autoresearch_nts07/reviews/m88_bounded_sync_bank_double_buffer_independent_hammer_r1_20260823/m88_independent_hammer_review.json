  "findings": [
    {
      "finding": "The max(DRAM,460-row-writer,128-parser)+commit preparation is causally feasible and fully charged, but M86 contains one bank image; its testbench supplies preformatted 256-bit rows and external 74B metadata.",
      "id": "M88-P1-01-DOUBLE-BUFFER-DMA-PARSER-WRITER-NOT-RTL",
      "impact": "M88 closes the bounded cycle-model gap, not the physical ping-pong DMA/record-parser/unpacker implementation or its timing/backpressure.",
      "severity": "P1"
    },
    {
      "finding": "The 3/4/4/5 service is applied to all heldout work as an always-ready throughput model. M86's 128 backpressured phases do not admit those intervals, and its sole escape still returns a zero placeholder.",
      "id": "M88-P1-02-ALWAYS-READY-AND-ESCAPE-CONSUMER-ASSUMPTION",
      "impact": "Zero midstream_load_stall_phases means zero ping-pong refill stalls, not zero FIFO/output/accumulator/correction/fallback stalls.",
      "severity": "P1"
    },
    {
      "finding": "Candidate and bit-sparse baseline use the same 32B/cycle DRAM and three-cycle 96B weight service, and both reload every phase. Candidate additionally receives 113.8KiB listed local structures plus matcher, packer and frontend logic.",
      "id": "M88-P1-03-BANDWIDTH-FAIR-NOT-EQUAL-AREA-BASELINE",
      "impact": "The 1.409375695x comparison is workload/bandwidth-fair, but not yet an equal-area, equal-power, or same-macro Synopsys comparison.",
      "severity": "P1"
    },
    {
      "finding": "116,525 bytes exactly covers two PWP images+metadata, two weight images, one response FIFO, pattern table and offset table. It excludes activation/descriptor queues, matcher/packer state, accumulators, correction/fallback routing, parser logic, ECC, macro padding and bank-select control.",
      "id": "M88-P1-04-113P8KIB-IS-PARTIAL-STORAGE-NOT-MODULE-AREA",
      "impact": "113.8KiB is a scoped storage subtotal, not total module SRAM/area.",
      "severity": "P1"
    },
    {
      "finding": "Centers use valid825 samples 0-4 and replay uses samples 5-9 of the same internal cohort; no train-only catalog, sequence-disjoint test, hardware-order accuracy, or full-network composition is present.",
      "id": "M88-P1-05-VALID825-INTERNAL-NO-ACCURACY-OR-SYSTEM-COMPOSITION",
      "impact": "The scoped module estimate is reproducible, but cannot support an accuracy-preserving, full-network, DATE, or best-paper speedup claim.",
      "severity": "P1"
    },
    {
      "finding": "Pattern and phase-offset tables are counted in storage but their cold preload, matcher table read ports, arbitration and energy are not charged.",
      "id": "M88-P2-01-COLD-PRELOAD-AND-READ-PORTS-UNMODELED",
      "impact": "Warm-resident cycle estimates remain valid; cold latency/energy does not.",
      "severity": "P2"
    },
    {
      "finding": "The model correctly charges 794,880 row writes per catalog pass although only 743,731 rows contain record words; 51,149 writes (6.88%) are explicit zero tail rows.",
      "id": "M88-P2-02-FULL-460-ROW-TAIL-OVERHEAD",
      "impact": "Correct but avoidable loader work; terminal-aware implicit zero could save it.",
      "severity": "P2"
    },
    {
      "finding": "M88 pins the M86 contract but only status/count strings from RUN_COMPLETE; it records, rather than pre-gates, M86 run/input-manifest SHA values.",
      "id": "M88-P2-03-M86-RUN-INPUT-MANIFEST-NOT-EXPECTED-SHA-GATED-IN-ANALYZER",
      "impact": "The current result freezes the observed hashes, but future reruns could accept a different similarly worded sealed run unless externally gated.",
      "severity": "P2"
    }
  ],
