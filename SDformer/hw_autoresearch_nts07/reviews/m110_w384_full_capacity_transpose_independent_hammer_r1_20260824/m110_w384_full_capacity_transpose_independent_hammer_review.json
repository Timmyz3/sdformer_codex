    {
      "id": "M110-H-P1-01-ACCUMULATOR-ABSENT",
      "severity": "P1",
      "finding": "M110 stops at descriptor transpose service. The signed24 384x8x96 accumulator, finite-width numeric miter, address/RMW/forwarding, clear/epoch and commit behavior are absent.",
      "impact": "The hardware block does not implement the dominant 884736-byte accumulator assumed by the M109 W384 point."
