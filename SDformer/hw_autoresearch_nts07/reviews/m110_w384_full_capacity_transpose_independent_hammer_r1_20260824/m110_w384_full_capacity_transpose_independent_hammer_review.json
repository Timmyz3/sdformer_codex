    {
      "id": "M110-H-P1-02-ACTUAL-INTEGRATED-CYCLE-REPLAY-ABSENT",
      "severity": "P1",
      "finding": "The full-capacity streams are synthetic. There is no actual ordered heldout integration of precompaction, PWP, correction service, accumulator flush and commit against the M109 dual timeline.",
      "impact": "2.535462x is not RTL-measured or scheduled module performance."
    },
    {
      "id": "M110-H-P1-03-PRE-DC-PRE-MACRO",
      "severity": "P1",
      "finding": "The 196608-bit bitmap uses whole-array synchronous reset and arbitrary bit set/clear, with macro_count=0 and no sealed M110 DC, SRAM mapping, timing, area or power result.",
      "impact": "The W384 capacity proof cannot be converted to physical, frequency, area, energy or equal-area claims."
    },
    {
      "id": "M110-H-P1-04-FAILFAST-NOT-GENERAL-BACKPRESSURE",
      "severity": "P1",
      "finding": "Presenting valid while both fill banks are unavailable triggers permanent quarantine instead of ordinary ready-low backpressure.",
      "impact": "Integration requires credit/ready look-ahead or an adapter; the interface is fail-fast, not a generally composable ready/valid sink."
    },
    {
      "id": "M110-H-P1-05-CONTEXT-BASE-PARTIAL-WINDOW-SCHEMA-OPEN",
      "severity": "P1",
      "finding": "The module protects bank-scoped base/context identity but does not freeze partition/operator bit allocation, base alignment/overflow semantics or legal partial-window row extent."
    },
    {
      "id": "M110-H-P2-01-PRODUCTION-INGRESS-ORDER-NOT-ADVERSARIAL",
      "severity": "P2",
      "finding": "The production full-capacity TB inserts keys and rows in the same ascending order as drain, so it does not independently stress transpose sorting. The independent reverse-order campaign closes this review gap."
    },
    {
      "id": "M110-H-P2-02-PRODUCTION-SVA-PROTOCOL-COVERAGE-GAPS",
      "severity": "P2",
      "finding": "Production SVA checks handshakes, quarantine and service shape but has no explicit exact-grace, changed-legal streaming, semantic-illegal or boundary-range assertions. Its stall-stability property also has no protocol-fault escape, unlike the independent assertion used for simultaneous unavailable-ingress quarantine."
    },
    {
      "id": "M110-H-P2-03-RAW-PAYLOAD-NOT-TOTAL-STORAGE",
      "severity": "P2",
      "finding": "196608 bits is exact for presence plus direction only. At least 314 metadata bits and additional controller/grace, ECC and macro rounding remain; M109's 909352 bytes is also only a combined lower bound."
    },
    {
      "id": "M110-H-P2-04-M109-DENOMINATOR-AND-DELIVERY-QUALIFIER",
      "severity": "P2",
      "finding": "M109's fixed8 denominator is a conditional service-token baseline without matched descriptor/controller ingress, while candidate input is assumed losslessly precompacted with no finite queue or delivery bandwidth replay."
