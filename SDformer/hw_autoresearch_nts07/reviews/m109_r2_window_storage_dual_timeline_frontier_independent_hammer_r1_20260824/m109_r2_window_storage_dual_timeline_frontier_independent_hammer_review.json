      "id": "M109R2-H-P1-01-COMBINED-CYCLE-MITER-ABSENT",
      "severity": "P1",
      "finding": "The controller_free software repair matches the independent recurrence, but there is still no integrated commercial M106/PWP/M104/flush/commit cycle miter.",
      "impact": "The frontier is a corrected software schedule bound, not RTL-measured cycle performance."
    },
    {
      "id": "M109R2-H-P1-02-ACCUMULATOR-NUMERIC-AND-MACRO-PORT-CUT",
      "severity": "P1",
      "finding": "The model assumes one signed24 96-lane accumulator update per service cycle without full-lane numeric equivalence, macro latency, RDW, clear/epoch or commit-hazard proof.",
      "impact": "Storage and cycles are not macro-inclusive or physical."
    },
    {
      "id": "M109R2-H-P1-03-SHARED-WEIGHT-SRAM-PORT-CUT",
      "severity": "P1",
      "finding": "Shared weight/PWP addresses, ports, latency, banking and contention remain outside the recurrence.",
      "impact": "The same-clock service-lane schedule may gain additional stalls after memory mapping."
    },
    {
      "id": "M109R2-H-P1-04-PRECOMPACTION-DELIVERY-PORT-CUT",
      "severity": "P1",
      "finding": "Correction descriptors and PWP requests are assumed losslessly precompacted and available; scan cost, finite queues and delivery bandwidth are absent.",
      "impact": "The result applies only to the precompacted service island."
    },
    {
      "id": "M109R2-H-P1-05-BASELINE-NOT-EQUAL-CONTROLLER",
      "severity": "P1",
      "finding": "The fixed8 denominator has exact service tokens and the same commit/flush tail, but no matched descriptor/controller ingress schedule.",
      "impact": "It is not an equal-controller or end-to-end baseline."
    },
    {
      "id": "M109R2-H-P2-01-ORDERED-DIGEST-NOT-CARRIED",
      "severity": "P2",
      "finding": "M108-r3 and the independent reconstruction agree on W64 ordered digest a011720a..., but M109-r2 does not emit or pin any per-window ordered descriptor digest.",
      "suggested_action": "Carry the digest and compact per-record counters into the frontier result/contract."
    },
    {
      "id": "M109R2-H-P2-02-W64-PRODUCER-CHECK-LIST-NOT-FULL-FIELD",
      "severity": "P2",
      "finding": "The analyzer explicitly compares 18 W64 integer fields to M108-r3 but omits ratio, headroom and both maximum fields; independent review confirms all 22 common fields match.",
      "suggested_action": "Compare the full common key set and the ordered digest fail-closed."
    },
    {
      "id": "M109R2-H-P2-03-W294-THRESHOLD-MARGIN-NARROW",
      "severity": "P2",
      "finding": "W294 is only 0.001495212113x below 2.5x, so omitted queues/memory/macros can move the crossing even though the corrected recurrence ordering is exact."
    },
    {
      "id": "M109R2-H-P2-04-METADATA-IS-MINIMUM-PAYLOAD",
      "severity": "P2",
