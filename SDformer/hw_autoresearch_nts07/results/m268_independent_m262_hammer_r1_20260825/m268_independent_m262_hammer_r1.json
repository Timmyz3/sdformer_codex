    "p1": [
      {
        "finding": "An illegal mode/count header held in IDLE is backpressured forever and does not enter the sticky abort path.",
        "id": "M268-P1-1",
        "impact": "The legal-input frozen contract passes, but fail-closed coverage is not universal over malformed headers.",
