      },
      {
        "finding": "The 1.672240x cycle and 2.580060x weight-request ratios are aggregate clean-latency mappings, not address-timed memory execution.",
        "id": "M268-P1-2",
        "impact": "Queueing, bank conflicts, capacity, SRAM latency, and physical timing can reduce the realized gain.",
        "required_before_headline": "Add address-level memory scheduling and full-trace or statistically bounded execution evidence."
      }
    ],
    "p2": [
      {
        "finding": "SVA checks only descriptor_retire_cycles>=9; exact 6+3*popcount equality is a directed-TB check and the clean suite does not enumerate every popcount 1..8.",
