  "findings": [
    {
      "id": "M398-P2-01",
      "severity": "P2",
      "title": "The DSE is fixed-product and common-port, not equal-area",
      "detail": "q*O=128 and SHARED96/SERIAL16 are held fixed, but catalog state, bitmap width, control, replay count and physical PWP stride differ. No synthesized equal-area claim is admitted across q."
    },
    {
      "id": "M398-P2-02",
      "severity": "P2",
      "title": "D8 feasibility is a deterministic timing proof, not RTL observation",
      "detail": "Request/response/bundle counts and L8 startup are exact and conserved, but FIFO occupancy, ready/valid edges and DMA interaction have not been observed in a full H67 VCS real-trace run."
    },
    {
      "id": "M398-P2-03",
      "severity": "P2",
      "title": "The baseline is still a cycle-model oracle",
      "detail": "All q points fairly share the same 742,148,386-cycle baseline, but matched-frequency baseline and candidate RTL/netlists do not yet establish physical throughput."
    },
    {
      "id": "M398-P2-04",
      "severity": "P2",
      "title": "Physical memory, power and energy remain outside scope",
      "detail": "The 160-byte q128 stride and DMA traffic are priced, but no physical SRAM macro, SPEF, activity-backed PTPX or energy-per-inference evidence exists."
    },
    {
      "id": "M398-P2-05",
      "severity": "P2",
      "title": "Runtime coverage is still one sequence cohort",
      "detail": "The runtime ratio uses ten zurich_city_09_a samples. The catalog is leakage-free train-only data across 18 sequences, but sequence/density-stratified runtime performance and system Amdahl impact remain unproven."
    }
