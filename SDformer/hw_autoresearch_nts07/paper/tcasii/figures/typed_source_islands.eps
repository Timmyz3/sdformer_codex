/box { /b exch def /g exch def /r exch def /h exch def /w exch def
  /y exch def /x exch def gsave r g b setrgbcolor newpath x y moveto
  w 0 rlineto 0 h rlineto w neg 0 rlineto closepath fill grestore
  0.22 0.27 0.34 setrgbcolor 0.9 setlinewidth newpath x y moveto
  w 0 rlineto 0 h rlineto w neg 0 rlineto closepath stroke } def
/cluster { /b exch def /g exch def /r exch def /h exch def /w exch def
  /y exch def /x exch def r g b setrgbcolor 1.2 setlinewidth newpath
  x y moveto w 0 rlineto 0 h rlineto w neg 0 rlineto closepath stroke } def
/arrow { /y2 exch def /x2 exch def /y1 exch def /x1 exch def
  0.22 0.27 0.34 setrgbcolor 1.1 setlinewidth newpath x1 y1 moveto
  x2 y2 lineto stroke /ang y2 y1 sub x2 x1 sub atan def gsave x2 y2
  translate ang rotate newpath 0 0 moveto -7 3.2 lineto -7 -3.2 lineto
  closepath fill grestore } def
/cshow { /s exch def /y exch def /x exch def
  x s stringwidth pop 2 div sub y moveto s show } def

