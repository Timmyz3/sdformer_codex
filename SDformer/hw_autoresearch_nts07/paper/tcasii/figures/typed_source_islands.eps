%!PS-Adobe-3.0 EPSF-3.0
%%BoundingBox: 0 0 520 120
%%LanguageLevel: 2
%%Pages: 1
%%EndComments

/DejaVuSans findfont 7.2 scalefont setfont
/box {
  /b exch def /g exch def /r exch def
  /h exch def /w exch def /y exch def /x exch def
  gsave r g b setrgbcolor newpath x y moveto w 0 rlineto
  0 h rlineto w neg 0 rlineto closepath fill grestore
  0.32 0.37 0.44 setrgbcolor 0.65 setlinewidth
  newpath x y moveto w 0 rlineto 0 h rlineto w neg 0 rlineto closepath stroke
} def
/cluster {
  /b exch def /g exch def /r exch def
  /h exch def /w exch def /y exch def /x exch def
  r g b setrgbcolor 0.9 setlinewidth
  newpath x y moveto w 0 rlineto 0 h rlineto w neg 0 rlineto closepath stroke
} def
/arrow {
  /y2 exch def /x2 exch def /y1 exch def /x1 exch def
  0.29 0.33 0.39 setrgbcolor 0.75 setlinewidth
  newpath x1 y1 moveto x2 y2 lineto stroke
  /ang y2 y1 sub x2 x1 sub atan def
  gsave x2 y2 translate ang rotate newpath 0 0 moveto -5 2.3 lineto
  -5 -2.3 lineto closepath fill grestore
} def
/cshow {
  /s exch def /y exch def /x exch def
  x s stringwidth pop 2 div sub y moveto s show
} def
/DejaVuSans-Bold findfont 7.6 scalefont setfont
5 45 78 32 0.90 0.91 0.93 box
44 63 (typed source) cshow
