%!PS-Adobe-3.0 EPSF-3.0
%%BoundingBox: 0 0 520 150
%%LanguageLevel: 2
%%Pages: 1
%%EndComments
/box { /b exch def /g exch def /r exch def /h exch def /w exch def
  /y exch def /x exch def gsave r g b setrgbcolor newpath x y moveto
  w 0 rlineto 0 h rlineto w neg 0 rlineto closepath fill grestore
  0.22 0.27 0.34 setrgbcolor 0.9 setlinewidth newpath x y moveto
  w 0 rlineto 0 h rlineto w neg 0 rlineto closepath stroke } def
/arrow { /y2 exch def /x2 exch def /y1 exch def /x1 exch def
  0.22 0.27 0.34 setrgbcolor 1.0 setlinewidth newpath x1 y1 moveto
  x2 y2 lineto stroke /ang y2 y1 sub x2 x1 sub atan def gsave x2 y2
  translate ang rotate newpath 0 0 moveto -6 2.8 lineto -6 -2.8 lineto
  closepath fill grestore } def
/cshow { /s exch def /y exch def /x exch def
  x s stringwidth pop 2 div sub y moveto s show } def

/DejaVuSans-Bold findfont 14 scalefont setfont
8 132 moveto (Ordinary token-major delivery) show
/DejaVuSans findfont 11.5 scalefont setfont
8 92 95 25 0.95 0.96 0.98 box 55.5 101 (request Wg) cshow
119 92 95 25 0.95 0.96 0.98 box 166.5 101 (response Wg) cshow
230 92 95 25 0.95 0.96 0.98 box 277.5 101 (private v*Wg) cshow
341 92 75 25 0.95 0.96 0.98 box 378.5 101 (commit) cshow
103 104 119 104 arrow 214 104 230 104 arrow 325 104 341 104 arrow
/DejaVuSans-Oblique findfont 11 scalefont setfont
431 104 moveto (x4 contexts) show

/DejaVuSans-Bold findfont 14 scalefont setfont
8 70 moveto (TSBG source-group-major delivery) show
/DejaVuSans findfont 11 scalefont setfont
8 23 88 27 0.90 0.97 0.93 box 52 33 (row match) cshow
108 23 88 27 0.83 0.95 0.88 box 152 33 (ONE read) cshow
208 23 88 27 0.83 0.95 0.88 box 252 33 (one response) cshow
308 23 100 27 0.90 0.97 0.93 box 358 33 (4 private v*W) cshow
420 23 92 27 0.90 0.97 0.93 box 466 33 (4 commits) cshow
96 36 108 36 arrow 196 36 208 36 arrow 296 36 308 36 arrow 408 36 420 36 arrow
/DejaVuSans-Oblique findfont 11 scalefont setfont
108 6 moveto (Hit is decided before SRAM enable; three requests and responses never toggle.) show
