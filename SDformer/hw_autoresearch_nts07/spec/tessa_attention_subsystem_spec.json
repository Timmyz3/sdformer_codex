{
  "schema_version": 1,
  "status": "exploratory_rtl_contract_frozen",
  "scope": "encoder_attention_subsystem",
  "paper_claim_boundary": "在encoder级周期和存储模型完成前，只称attention accelerator",
  "parameters": {
    "head_dim": 32,
    "tokens_per_row": 162,
    "pairs_per_row": 81,
    "score_width": 16,
    "score_fraction": 7,
    "gate_width": 9,
    "gate_fraction": 7,
    "threshold_width": 8,
    "token_index_width": 8,
    "row_tag_width": 16,
    "class_index_width": 6,
    "histogram_count_width": 8,
    "active_entry_width": 56,
    "context_options": [1, 2, 4],
    "first_rtl_contexts": 2,
    "active_commit_fifo_depth": 2,
    "histogram_commit_fifo_depth": 2
  },
  "compile_modes": {
    "H67": {
      "motion_xor_enable": true,
      "score_class_depth": 35,
      "class_scan_cycles": 2
    },
    "H68": {
      "motion_xor_enable": false,
      "score_class_depth": 3,
      "class_scan_cycles": 1
    }
  },
  "clock_reset": {
    "clock": "clk_core",
    "target_mhz_exploratory": 500,
    "clock_domains": 1,
    "reset": "rst_n_core",
    "reset_active_low": true,
    "reset_synchronous": true,
    "cdc_required": false
  },
  "interfaces": {
    "descriptor": {
      "handshake": "valid_ready",
      "width": 64,
      "fields": {
        "stage": 2,
        "block": 3,
        "head": 5,
        "window": 10,
        "row_tag": 16,
        "n_pairs": 7,
        "threshold_q8": 8,
        "preserve_mean": 1,
        "pccc_enable": 1,
        "reserved": 11
      }
    },
    "pair_input": {
      "handshake": "valid_ready",
      "payload_width": 128,
      "payload_fields": {
        "q0_bits": 32,
        "q1_bits": 32,
        "k0_bits": 32,
        "k1_bits": 32
      },
      "sideband_fields": {
        "row_tag": 16,
        "pair_index": 7,
        "pair_last": 1
      },
      "metadata_policy_first_rtl": "derive_from_payload",
      "source_variants": [
        "one_128bit_read",
        "two_64bit_banks_same_cycle",
        "one_64bit_port_two_cycle_fallback"
      ]
    },
    "pair_result": {
      "slots": 2,
      "slot_width": 64,
      "atomic_accept": true,
      "slot_fields": {
        "valid": 1,
        "kzero": 1,
        "score_q7": 16,
        "k_bits": 32,
        "token_index": 8,
        "class_index": 6
      }
    },
    "sparse_output": {
      "handshake": "valid_ready",
      "fields": {
        "row_tag": 16,
        "token_index": 8,
        "k_bits": 32,
        "gate_q17": 9,
        "threshold_q8": 8,
        "row_last_active": 1
      },
      "zero_active_row_completion": "row_done_without_output"
    },
    "completion": {
      "handshake": "valid_ready",
      "fields": {
        "row_tag": 16,
        "active_entries": 8,
        "status": 4
      }
    }
  },
  "commit_contract": {
    "active_bank_write_ports_per_context": 1,
    "histogram_write_ports_per_context": 1,
    "banks_independent": true,
    "mixed_pair_parallel_commit": true,
    "same_class_merge": "optional_plus2_when_enabled",
    "different_class_behavior": "enqueue_two_histogram_updates",
    "both_active_behavior": "enqueue_two_active_entries",
    "atomic_pair_rule": "pair_result_ready_only_when_each_required_queue_has_capacity",
    "consecutive_same_class_bypass": true,
    "pccc_bypass_required": true
  },
  "context_memory": {
    "active_bank": {
      "depth": 162,
      "width": 56,
      "ports": "1W1R",
      "read_latency": 1,
      "implementation": "synchronous_memory_wrapper"
    },
    "histogram": {
      "depth_h67": 35,
      "depth_h68": 3,
      "width": 8,
      "implementation_first_rtl": "register_bank_with_write_bypass"
    },
    "occupied_bitmap_width_h67": 35,
    "row_state_bits_budget": 256,
    "descriptor_bits": 64
  },
  "row_completion_invariants": {
    "accepted_pairs": 81,
    "semantic_tokens_committed": 162,
    "required_queues_empty": true,
    "class_and_active_counts_sum_to": 162,
    "backend_start_after_commit_complete": true
  },
  "performance_counters": [
    "cycles_total",
    "pairs_accepted",
    "pair_input_stall_cycles",
    "active_commit_stall_cycles",
    "histogram_commit_stall_cycles",
    "pccc_same_class_merges",
    "pccc_dual_class_pairs",
    "both_active_pairs",
    "context_occupancy_cycles_0_to_4",
    "scs_busy_cycles",
    "output_stall_cycles",
    "block_barrier_drain_cycles",
    "max_row_latency_cycles"
  ],
  "feature_gates": {
    "fixed_bitmap_pesf": "conditional_go",
    "contexts_1_2": "conditional_go",
    "context_4_physical": "no_go_until_ordered_trace",
    "pccc_forced_on": "no_go_until_same_class_profile",
    "union_event": "no_go",
    "bmrf": "no_go",
    "row_ooo": "no_go",
    "directional_bank_mapping": "no_go",
    "heterogeneous_dual_core": "dse_only"
  }
}
