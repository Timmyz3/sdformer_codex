      "severity": "P0",
      "id": "RAW_AMPLITUDE_PROXY_NOT_BINARY_HAMMING",
      "finding": "PAFT uses abs(raw_activation-pattern) and raw_activation.sum although ATLIF outputs zero or trainable threshold amplitude; the proxy can improve without reducing support work."
    },
    {
      "severity": "P1",
      "id": "M71_TOP_FREQUENCY_NOT_PHI_KMEANS",
      "finding": "M71 selects top exact-frequency patterns; Phi-style filtered Hamming Lloyd is represented only by M72 and improves candidate work by 1.264529x over M71."
    },
    {
      "severity": "P1",
      "id": "M70_OUTPUT_BLOCK_FACTOR_OMITTED_FROM_LABEL",
      "finding": "M70 absolute counters omit eight output blocks; ratios are correct but the claimed physical vector-add labels are not."
    },
    {
      "severity": "P1",
      "id": "PWP_TRAFFIC_AND_MATCHER_UNCHARGED",
      "finding": "A 12-bit PWP vector is 144 B versus a 96 B INT8 baseline vector; matcher, assignment, PWP traffic, ports, and packing are uncharged."
    },
    {
      "severity": "P1",
      "id": "WORKING_SET_NAME_TOO_NARROW",
      "finding": "2304 B is exactly one partition and one output block, not an execution working set; reuse across eight blocks needs at least 18432 B PWP or rematch/assignment storage."
    },
    {
      "severity": "P1",
      "id": "CATALOG_PROVENANCE_NOT_FAIL_CLOSED",
      "finding": "The PAFT loader trusts schema and a self-declared leakage boolean but does not pin catalog/builder/trace/list/checkpoint/operator identities."
    },
    {
      "severity": "P1",
      "id": "THRESHOLD_CARRY_AND_PWP_PAYLOAD_UNPROVEN",
      "finding": "M40 inputs are noninteger threshold-scaled positives, while M71 has no quantized weight or actual PWP payload; support work is valid but exact arithmetic needs a frozen late-scale numeric bridge."
    },
    {
      "severity": "P1",
      "id": "PAFT_OBJECTIVE_CONFOUNDED_WITH_SPARSITY",
      "finding": "Absolute candidate cost rewards zero-activity collapse; a paired no-PAFT and equal-activity comparison is required."
    },
    {
      "severity": "P1",
      "id": "ANALYZER_SOURCE_SHA_TOCTOU",
      "finding": "An M72 process loaded old code but, after the source changed during execution, emitted the new file SHA. Start/end SHA equality or an external launch manifest is required."
    }
