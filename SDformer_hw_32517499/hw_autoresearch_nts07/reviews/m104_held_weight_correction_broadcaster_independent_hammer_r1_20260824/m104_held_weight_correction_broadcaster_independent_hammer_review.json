    },
    {
      "id": "M104-P1-01-PERFECT-KEY-BATCHING-NOT-SCHEDULED",
      "severity": "P1",
      "finding": "M103 groups are order-independent; no bounded transpose queue, phase drain, spill/fallback or actual-record replay exists.",
      "required_action": "Capture ordered semantics and execute a bounded key transpose before any scheduled performance claim."
    },
    {
      "id": "M104-P1-02-ACCUMULATOR-SEMANTICS-PORT-CUT",
      "severity": "P1",
      "finding": "Destination bank/address/port, PWP dependencies and finite-width update semantics are absent.",
      "required_action": "Freeze accumulator policy and miter original versus reordered final state."
    },
    {
      "id": "M104-P1-03-E-PLUS-2G-NEEDS-NEW-MICROARCHITECTURE",
      "severity": "P1",
      "finding": "The current one-held-vector collision policy cannot overlap a load with an event.",
      "required_action": "Add third-beat/first-event fusion or ping-pong held-vector preload if E+2G is a design target."
    },
    {
      "id": "M104-P1-04-DC-RUN-NOT-YET-SEALED",
      "severity": "P1",
      "finding": "The production-only filelist is sufficient source inventory, but M104 has no sealed dedicated DC runner/SDC/receipt yet.",
      "required_action": "Run exact-SHA common-period logic-only DC and retain pre-macro claim boundaries."
    },
    {
      "id": "M104-P2-01-LAST-VALID-RELEASE-CONTRACT",
      "severity": "P2",
