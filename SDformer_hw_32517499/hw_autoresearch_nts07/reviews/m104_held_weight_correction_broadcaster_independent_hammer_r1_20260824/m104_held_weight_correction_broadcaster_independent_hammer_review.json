    {
      "id": "M104-P0-01-TOKEN-LEDGER-RTL-PROTOCOL-MISMATCH",
      "severity": "P0",
      "finding": "The published result declares three load tokens per group plus one destination token per event, but reports E+2G; its literal fields and current mutually exclusive RTL require E+3G.",
