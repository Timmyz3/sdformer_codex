  "findings": [
    {
      "id": "M111-H-P1-01-M110-M111-INTEGRATED-CYCLE-MITER-ABSENT",
      "severity": "P1",
      "finding": "M110 proves a standalone W384 transpose controller and M111 proves a standalone accumulator frontend, but there is no commercial-VCS composition that replays their exact token and memory timing together.",
      "impact": "The 2.53546204172554x value remains the M109-r2 software schedule projection, not a measured RTL cycle ratio."
    },
    {
      "id": "M111-H-P1-02-FOUNDRY-SRAM-AND-RDW-UNCHARACTERIZED",
      "severity": "P1",
      "finding": "All data banks are behavioral synchronous 1R1W arrays. No foundry macro, compiler option, depth/width rounding, read latency, output register, RDW mode, ECC or peripheral energy is closed.",
      "impact": "The command protocol is functionally admitted, but storage area, timing, energy and macro feasibility are not."
    },
    {
      "id": "M111-H-P1-03-WIDE-DATAPATH-PHYSICAL-CLOSURE-ABSENT",
      "severity": "P1",
      "finding": "The frontend contains 96 parallel signed 25-bit additions plus 2304-bit read, write, update and commit paths; no exact-SHA DC/STA/PTPX result exists for this milestone.",
      "impact": "Same-clock feasibility and physical throughput cannot be inferred from behavioral VCS."
    },
    {
      "id": "M111-H-P1-04-SAME-ADDRESS-LIVENESS-IS-EXTERNAL",
      "severity": "P1",
      "finding": "A consecutive same-address update intentionally enters permanent reset-only quarantine. Avoidance depends on the external M108 ordering promise, but no actual heldout integrated replay proves that every emitted stream respects the intervening-edge rule.",
      "impact": "Standalone fail-close safety is correct; workload-wide liveness is not yet admitted."
    },
    {
      "id": "M111-H-P1-05-MATCHED-PHYSICAL-BASELINE-ABSENT",
      "severity": "P1",
      "finding": "There is no same-library, same-frequency, equal-area baseline including accumulator macros, controller, delivery and commit traffic.",
      "impact": "Neither 2.535x nor any M111 test count is a physical, energy, full-network or headline speedup."
    },
    {
      "id": "M111-H-P2-01-NEGATIVE-OVERFLOW-NOT-IN-PRODUCTION-REGRESSION",
      "severity": "P2",
      "finding": "The sealed production suite attacks +max+1 only. The independent VCS witness additionally proves -min-1 suppression and sticky quarantine.",
      "suggested_action": "Promote the negative-overflow vector into the exact-SHA production regression."
    },
    {
      "id": "M111-H-P2-02-MACRO-COMMAND-CONSERVATION-NOT-IN-PRODUCTION-SVA",
      "severity": "P2",
      "finding": "Production SVA checks onehot0 commands but not exact accepted-update bank/row reads, buffered write data, unique valid-row commit reads, or invalid-row no-read behavior. The independent TB checks all four.",
      "suggested_action": "Promote command conservation assertions or a reusable macro protocol monitor."
    },
    {
      "id": "M111-H-P2-03-LINKED-STORAGE-LOWER-BOUND-OMITS-VALID-BITS",
      "severity": "P2",
      "finding": "The linked M109-r2 909352-byte lower bound explicitly excludes valid/epoch tags, while M111 implements 3072 valid bits (384 bytes).",
      "suggested_action": "Use at least 909736 logical bytes for the combined W384 descriptor+accumulator+valid subtotal before macro rounding; retain 884736-byte accumulator data and 3072-bit valid figures separately."
    },
    {
      "id": "M111-H-P2-04-COMMIT-SIDEBANDS-MUST-BE-VALID-QUALIFIED",
      "severity": "P2",
      "finding": "commit_block, commit_row and commit_last expose retained pipeline state when commit_valid is low; this is legal ready/valid behavior but is not an idle-zero contract.",
      "suggested_action": "Require every downstream consumer and future assertion to qualify all commit fields with commit_valid."
    },
    {
      "id": "M111-H-P2-05-DIRECTED-NOT-EXHAUSTIVE",
      "severity": "P2",
      "finding": "Both suites are bounded directed tests. They do not exhaust all 24-bit lane combinations, all address histories, reset placements or arbitrary backpressure traces.",
      "suggested_action": "Add constrained-random scoreboarding and formal safety properties before freeze."
    }
