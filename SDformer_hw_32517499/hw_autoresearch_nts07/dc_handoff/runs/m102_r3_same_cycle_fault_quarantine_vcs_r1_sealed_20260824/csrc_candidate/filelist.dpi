DPI_STUB_OBJS_OBJ0=./../simv_candidate.daidir/vc_hdrs.o
DPI_STUB_OBJS_SRC0=./../simv_candidate.daidir/vc_hdrs.c
DPI_STUB_OBJS += $(DPI_STUB_OBJS_OBJ0)
$(DPI_STUB_OBJS_OBJ0): $(DPI_STUB_OBJS_SRC0)
	@$(CC) -I/opt/synopsys/vcs/V-2023.12-SP1/include  -pipe -fPIC    -I/opt/synopsys/vcs/V-2023.12-SP1/include  -fPIC -c -o $(DPI_STUB_OBJS_OBJ0) $(DPI_STUB_OBJS_SRC0)
	@strip -g $(DPI_STUB_OBJS_OBJ0)
