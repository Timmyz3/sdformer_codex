# Keep compact deployment inputs, not dense train captures or build products.
__pycache__/
representation/train_captures/*.npz
!representation/parameters/*.npz
!algorithm/initialization/*_constants.npz
!algorithm/matched_training/*/stage*/deployed_constants.npz
!algorithm/matched_training/*/stage*/master_parameters.pt
!source_execution/*/*_gates.bin
!source_constant_probe/*/deployed_constants.npz
!source_constant_probe/*/cpu_gold.npz
!source_constant_probe/*/*_gates.bin
!hardware/native_bn_join/native_w8/native_w8.npz
!hardware/matched_local_chain/*_cpu_endpoints.npz
!hardware/source_constant_local_chain/*_cpu_endpoints.npz
!algorithm/hardware_exports/*/*.npz
!algorithm/source_constant_aee/*/hardware_exports/*.npz
!algorithm/native_w8_aee/first_frame_local_outputs.npz
