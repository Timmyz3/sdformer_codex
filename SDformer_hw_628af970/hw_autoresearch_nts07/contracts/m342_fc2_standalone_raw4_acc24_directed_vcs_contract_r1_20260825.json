  "objective": "Integrate the frozen M216 raw4 frontend with the frozen M218 K8 Acc24 service and a scope-matched M216 SOURCE_CAP=1 plus M219 K1 baseline behind one logical eight-bank memory interface.",
  "boundary": {
    "input": "raw FC2 activity: ordered beat index plus 96-bit bitmap, four beats per accepted packet",
    "output": "raw signed Acc24 FC2 accumulator, six 16-lane slices per output block",
    "includes": [
      "M214 raw4 compaction through M216",
      "M216 SOURCE_CAP=8 to M218 candidate",
      "M216 SOURCE_CAP=1 onehot-to-scalar adapter to M219 baseline",
      "tagged O8/FIFO4 service",
      "logical eight-bank signed INT8 weights",
      "committed block-major slice-major Acc24 results"
    ],
    "excludes": [
      "FC1",
      "BN2",
      "SN2",
      "scale or quantized requantization",
      "complete FFN",
      "complete network",
      "physical SRAM macro",
      "post-layout timing or power"
    ]
  },
  "integration_contract": {
    "header": "atomic mutual-ready fork/join; frontend and service accept on exactly the same edge",
    "k8_group": "M216 group tag/block/count/mask/channel payload is structurally connected bit-for-bit to M218",
    "k1_group": "M216 SOURCE_CAP=1 onehot mask is losslessly encoded to M219 bank_id; malformed masks fail closed",
    "completion": "M216 token_done is consumed only as service frontend_done; external token_done is driven only by M218 or M219",
    "soft_flush": "constant zero",
    "reset": "one common active-high POR for frontend, service, adapter, and test memory",
    "source_mapping": "src = 96*beat + 8*row + bank",
    "destination_mapping": "dst = 96*output_block + 16*slice + lane"
  },
  "fair_baseline": {
    "candidate_source_cap": 8,
    "baseline_source_cap": 1,
    "same_raw_payload": true,
    "same_weight_function": true,
    "same_active_bank_reads": true,
    "same_eight_logical_banks": true,
    "same_memory_latency_cycles": 4,
    "same_request_stall_schedule": true,
    "same_result_and_done_stall_schedule": true,
    "same_accumulator_width_bits": 24
  },
  "required_tests": {
    "clean_cases": 10,
    "nonzero_shapes": [1, 2, 4, 8],
