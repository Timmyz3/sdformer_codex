    {
      "id": "M556-R3-P1-01",
      "title": "The last-output-block/time-epoch/directory-clear transition is not uniquely ordered",
      "evidence": {
        "common_priority_row": 8,
        "guard_literal": "block or time close predicate is true",
        "action_literal": "Execute one explicit block/time transition or directory-clear edge",
        "multiple_named_actions_share_one_guard_without_subpriority": true,
        "last_block_can_satisfy_block_and_time_close_preconditions": true,
        "directory_clear_is_a_charged_1024_word_sequence": true,
        "goldens_cover_terminal_block_time_or_directory_clear": false,
        "ordinary_last_block_transition_is_runner_independent": false
      },
      "impact": "At the final output block of a layer/time, an implementation can retire the block, begin/advance directory clear, or retire the time epoch in different charged orders. That changes block-transition/time-clear cycles, state ownership, ready-transcript alignment and the point selected as A1-STRONG.",
      "required_fix": "Add a single ordered terminal submachine with mutually exclusive guards and complete deltas for non-last-block retire, last-block retire, directory-clear start/word-i advance/end, time-epoch retire and next-time owner load. Add at least one last-block/time golden schedule/hash."
    },
    {
      "id": "M556-R3-P1-02",
      "title": "The future authorization identity contains a runner/authentication hash cycle",
      "evidence": {
        "authorization_must_be_authored_after_final_release_review": true,
        "authorization_binds_runner_python_and_shell_sha": true,
        "authorization_binds_contract_runner_and_final_release_review_identities": true,
        "runner_source_and_shell_are_required_to_freeze_authorization_file_sha": true,
        "runner_source_static_review_precedes_final_release": true,
        "mutating_runner_after_authorization_invalidates_bound_runner_review": true,
        "non_circular_construction_exists_under_current_schema": false
      },
      "impact": "A runner cannot be frozen and reviewed before a later authorization exists while also embedding that authorization's SHA, because the later authorization contains the runner and review identities. Repairing the runner after authorization invalidates those identities. The closed launch chain is therefore not constructible as specified.",
      "required_fix": "Break the cycle. One valid pattern is a canonical-path, separately double-sealed post-review authorization that binds immutable runner/review bytes; the immutable runner rehashes and validates that authorization and its seals but does not embed the authorization SHA. Alternatively add a later separately reviewed launcher wrapper and define its one-way identity chain explicitly."
    }
  ],
