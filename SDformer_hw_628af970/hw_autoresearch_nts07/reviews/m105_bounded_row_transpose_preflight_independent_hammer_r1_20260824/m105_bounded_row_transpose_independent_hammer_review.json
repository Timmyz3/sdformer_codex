  "findings": [
    {
      "id": "M105-H-P1-01-THRESHOLD-MARGIN",
      "severity": "P1",
      "finding": "The 43-row 2x and 294-row 2.5x thresholds tolerate only about 3.67 and 2.08 unmodeled tokens per window.",
      "impact": "Neither threshold is a credible scheduled-cycle promise."
    },
    {
      "id": "M105-H-P1-02-ACCUMULATOR-PORT-CUT",
      "severity": "P1",
      "finding": "Accumulator banks, RMW ports, finite width, commit and dependency order are not modeled.",
      "impact": "One event token cannot be equated with one executable cycle."
    },
    {
      "id": "M105-H-P1-03-LOOP-ORDER-STORAGE-TRADEOFF",
      "severity": "P1",
      "finding": "Partition-major order leaves about 6.9 MB of full-raster accumulator state live; window-major order changes weight/PWP load residency assumptions.",
      "impact": "The window size does not independently bound total hardware storage."
    },
    {
      "id": "M105-H-P1-04-LOSSLESS-BUFFER-MAXIMUM",
      "severity": "P1",
      "finding": "Lossless queues require maxima or a proved backpressure/spill policy; p95/p99 cannot be used as hard capacity.",
      "impact": "The 294-row point reaches 11128 events in one window."
    },
    {
      "id": "M105-H-P1-05-NO-EXECUTABLE-SHARED-PORT-SCHEDULE",
      "severity": "P1",
      "finding": "Group loads, event tokens and the existing PWP ledger are added without descriptor issue, fill/drain or shared-port arbitration.",
      "impact": "The result is a conditional token envelope, not a scheduled cycle model."
    },
    {
      "id": "M105-H-P2-01-VALID825-INTERNAL",
      "severity": "P2",
      "finding": "M72 calibration and heldout data remain inside valid825 and are not a train-only catalog or independent validation."
    },
    {
      "id": "M105-H-P2-02-WINDOW-ALIGNMENT",
      "severity": "P2",
      "finding": "All windows are anchored at phase row zero; other alignment or dynamic windows may change reuse."
    },
    {
      "id": "M105-H-P2-03-DIRECTION-TOKEN",
      "severity": "P2",
      "finding": "Direction is not part of the group key and must remain in every event token."
    },
    {
      "id": "M105-H-P2-04-METADATA-AND-ENERGY-UNPRICED",
      "severity": "P2",
      "finding": "Destination offsets, group pointers, counts, valid bits, ECC and SRAM traffic are uncharged."
    },
    {
      "id": "M105-H-P2-05-FULL-WINDOW-IS-UPPER-ENVELOPE",
      "severity": "P2",
      "finding": "The 3000-row 2.668x point is a full-phase conditional upper envelope only."
    }
